    "scope": "",
    "language": "tsx",
    "file_language": "tsx",
    "content": "function Counter({ label }: CounterProps): ReactNode {\n  const [count, setCount] = useState(INITIAL_COUNT);\n  return (\n    <button onClick={() => setCount(count + 1)}>\n      {label}: {count}\n    </button>\n  );\n}",
