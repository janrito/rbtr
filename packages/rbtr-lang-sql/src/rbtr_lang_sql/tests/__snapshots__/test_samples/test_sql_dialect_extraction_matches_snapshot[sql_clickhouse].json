    },
    "scope": "",
    "language": "sql",
    "file_language": "sql",
    "content": "CREATE MATERIALIZED VIEW events_mv\nENGINE = SummingMergeTree\nORDER BY user_id\nAS SELECT user_id, count() AS c FROM events GROUP BY user_id",
    "span": {
      "start": 14,
      "end": 17
