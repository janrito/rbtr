<mxfile><diagram name="write-session"><mxGraphModel dx="1100" dy="480" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="480" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A write session: one transaction, one file, one repo" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#4d4d4c;fontStyle=1;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Rows are filed under the session&#x27;s repo. A read inside the write sees what the write has done." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#8e908c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1020" height="44" as="geometry"/></mxCell><mxCell id="w" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;Writes&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-family:Iosevka;color:#4d4d4c;&quot;&gt;add_chunk(chunk)&lt;br/&gt;insert_snapshots(rows)&lt;br/&gt;mark_indexed(snapshot_sha=…)&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4c;strokeWidth=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="120" as="geometry"/></mxCell><mxCell id="r" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;Reads inside the write&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;&lt;span style=&quot;font-family:Iosevka;color:#4d4d4c;&quot;&gt;blob_is_current(blob, …)&lt;br/&gt;get_snapshot_language(path)&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4c;strokeWidth=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="320" height="100" as="geometry"/></mxCell><mxCell id="ws" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;WriteSession&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;made by index.session(repo); holds one cursor and that repo; no write takes a repo&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4c;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="300" height="130" as="geometry"/></mxCell><mxCell id="cur" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;Its cursor&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;began the transaction&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eaeed9;strokeColor=#718c00;strokeWidth=1;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="260" height="80" as="geometry"/></mxCell><mxCell id="file" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;The project&#x27;s file&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;one DuckDB file per project&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ede6f2;strokeColor=#8959a8;strokeWidth=1;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4d4d4c;strokeWidth=1.4;jumpStyle=arc;jumpSize=7;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" edge="1" parent="1" source="w" target="ws"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4d4d4c;strokeWidth=1.4;jumpStyle=arc;jumpSize=7;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googlea