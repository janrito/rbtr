<mxfile><diagram name="fusion"><mxGraphModel dx="1100" dy="500" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="500" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="How scores are fused" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#4d4d4c;fontStyle=1;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Each chunk&#x27;s three scores become one; the reranker then reorders the best few." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#8e908c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1020" height="44" as="geometry"/></mxCell><mxCell id="sc" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;Three scores&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;keyword, meaning, name; 0 where a search missed it&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4c;strokeWidth=1;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="320" height="110" as="geometry"/></mxCell><mxCell id="no" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;Normalise&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;each to 0–1 across the candidates&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4c;strokeWidth=1;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="390" y="140" width="320" height="110" as="geometry"/></mxCell><mxCell id="noe" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4d4d4c;strokeWidth=1.4;jumpStyle=arc;jumpSize=7;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" edge="1" parent="1" source="sc" target="no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="we" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;Weigh&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;α·meaning + β·keyword + γ·name; α, β, γ by query kind&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4c;strokeWidth=1;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="740" y="140" width="320" height="110" as="geometry"/></mxCell><mxCell id="wee" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4d4d4c;strokeWidth=1.4;jumpStyle=arc;jumpSize=7;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" edge="1" parent="1" source="no" target="we"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mu" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;Multiply&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;× kind × file × importance × proximity&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4c;strokeWidth=1;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="320" height="110" as="geometry"/></mxCell><mxCell id="rr" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;Blend with the reranker&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;w·fused + (1 − w)·reranker, for the top few; keep the best k&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#feeddd;strokeColor=#f5871f;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;dashed=1;dashPattern=6 5;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="390" y="340" width="320" height="110" as="geometry"/></mxCell><mxCell id="rre" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4d4d4c;strokeWidth=1.4;jumpStyle=arc;jumpSize=7;endArrow=blockThin;endFill=1;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" edge="1" parent="1" source="mu" target="rr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="down" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4d4d4c;strokeWidth=1.4;jumpStyle=arc;jumpSize=7;endArrow=blockThin;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" edge="1" parent="1" source="we" target="mu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="300"/><mxPoint x="200" y="300"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
