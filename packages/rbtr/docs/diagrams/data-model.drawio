<mxfile><diagram name="data-model"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="The index&#x27;s tables" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#4d4d4c;fontStyle=1;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="The registry names projects and repos; a project&#x27;s file holds its data. Both also have a meta table." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#8e908c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1020" height="44" as="geometry"/></mxCell><mxCell id="zr" value="&lt;span style=&quot;letter-spacing:1.6px;&quot;&gt;REGISTRY · INDEX.DUCKDB&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=0;collapsible=0;pointerEvents=0;dashed=1;dashPattern=6 5;strokeWidth=1.5;strokeColor=#8959a8;fillColor=#ede6f2;fillOpacity=35;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=12;fontStyle=0;fontColor=#8959a8;fontFamily=Iosevka;fontSource=https%3A%2F%2Fcdn.jsdelivr.net%2Fnpm%2F%40fontsource%2Fiosevka%405.3.0%2Ffiles%2Fiosevka-latin-400-normal.woff2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="480" as="geometry"/></mxCell><mxCell id="projects" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;projects&lt;/b&gt;&lt;div style=&quot;height:6px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:12px;li