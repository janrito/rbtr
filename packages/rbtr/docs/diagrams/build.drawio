<mxfile><diagram name="build"><mxGraphModel dx="1100" dy="560" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="560" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A build is three transactions" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#4d4d4c;fontStyle=1;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Each commits on its own. A build that stops between them leaves residue the next build clears." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#8e908c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1020" height="44" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;1 · Extract&lt;/b&gt;&lt;div style=&quot;height:7px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#4d4d4c;font-size:13px;line-height:1.45;&quot;&gt;every file of the snapshot: its chunks, and which blob each path holds&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d4d4c;strokeWidth=1;verticalAlign=top;align=center;spacingTop=8;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#4d4d4c;fontFamily=Jost;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DJost%3Aital%2Cwght%400%2C100..900%3B1%2C100..900%26display%3Dswap;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="560" height="90" as="geometry"/></mxCell><mxCell id="w_chunks" value="&lt;b style=&quot;font-size:15px;color:#4d4d4c;&quot;&gt;chunks